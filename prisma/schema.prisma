generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  DEVELOPER
  DESIGNER
}

enum RequestType {
  CONTACT
  DEVIS
  RENDEZ_VOUS
}

enum RequestStatus {
  NOUVEAU
  EN_COURS
  TRAITE
  CONVERTI
  REFUSE
}

enum InvoiceType {
  PROFORMA
  FACTURE
}

enum InvoiceStatus {
  EN_ATTENTE
  PAYEE
  ANNULEE
}

enum PaymentMethod {
  CARTE_BANCAIRE
  VIREMENT
  ESPECES
}

enum PaymentPlan {
  PAIEMENT_COMPLET
  PAIEMENT_2_FOIS
  PAIEMENT_3_FOIS
}

enum FollowUpStatus {
  A_FAIRE
  EN_COURS
  TERMINE
}

model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  name      String?
  password  String?
  role      UserRole  @default(ADMIN)
  sessions  Session[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
}

model CompanyInfo {
  id                Int      @id @default(autoincrement())
  name              String   @default("collab·dev")
  legalName         String   @default("Collectif collab·dev")
  representative    String   @default("")
  representativeRole String   @default("")
  legalStatus       String?
  address           String?
  phone             String?
  email             String?
  website           String?
  taxId             String?
  iban              String?
  bic               String?
  currency          String   @default("EUR")
}

model Client {
  id        Int        @id @default(autoincrement())
  name      String
  company   String?
  email     String?
  phone     String?
  address   String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  requests  Request[]
  invoices  Invoice[]
  followUps FollowUp[]

  @@index([company])
}

model Request {
  id        Int           @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  type      RequestType   @default(CONTACT)
  message   String?
  status    RequestStatus @default(NOUVEAU)
  serviceId Int?
  service   Service?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  clientId  Int?
  client    Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  followUps FollowUp[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Service {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  slug         String        @unique
  description  String?
  details      String[] @default([])
  duration     String?
  price        Decimal       @db.Decimal(10, 2)
  category     String
  isPack       Boolean       @default(false)
  active       Boolean       @default(true)
  requests     Request[]
  invoiceItems InvoiceItem[]
  createdAt    DateTime      @default(now())

  @@index([category])
  @@index([active])
}

model Invoice {
  id            Int           @id @default(autoincrement())
  reference     String        @unique
  type          InvoiceType   @default(FACTURE)
  status        InvoiceStatus @default(EN_ATTENTE)
  date          DateTime      @default(now())
  dueDate       DateTime?
  downloadToken String?       @unique
  clientId      Int
  client        Client        @relation(fields: [clientId], references: [id])
  items         InvoiceItem[]
  payments      Payment[]
  totalAmount   Decimal       @db.Decimal(10, 2)
  note          String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status])
  @@index([type])
  @@index([date])
}

model InvoiceItem {
  id        Int      @id @default(autoincrement())
  invoiceId Int
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  serviceId Int?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  label     String
  quantity  Int      @default(1)
  unitPrice Decimal  @db.Decimal(10, 2)
  total     Decimal  @db.Decimal(10, 2)
  free      Boolean  @default(false)
}

model Payment {
  id                Int           @id @default(autoincrement())
  invoiceId         Int
  invoice           Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  method            PaymentMethod @default(CARTE_BANCAIRE)
  plan              PaymentPlan   @default(PAIEMENT_COMPLET)
  currentNumber     Int           @default(1)
  totalInstallments Int           @default(1)
  amountPaid        Decimal       @db.Decimal(10, 2)
  remaining         Decimal       @db.Decimal(10, 2)
  paymentDate       DateTime?
  createdAt         DateTime      @default(now())
}

model FollowUp {
  id         Int            @id @default(autoincrement())
  requestId  Int?
  request    Request?       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  clientId   Int?
  client     Client?        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  note       String
  nextAction String?
  status     FollowUpStatus @default(A_FAIRE)
  dueDate    DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([status])
  @@index([dueDate])
}
